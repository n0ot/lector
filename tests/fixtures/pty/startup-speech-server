#!/bin/bash

set -u

if [[ $# -ne 3 \
    || $1 != "one argument" \
    || $2 != "'literal quotes'" \
    || $3 != '$(not a shell)' ]]; then
    printf 'LECTOR-SPEECH-ARGV-ERROR' >&2
    exit 64
fi

initialized=0
while IFS= read -r request; do
    id=${request#*\"id\":}
    id=${id%%,*}
    case "$request" in
        *'"method":"initialize"'*)
            initialized=1
            printf '{"jsonrpc":"2.0","id":%s,"result":{"protocol_version":"1.0","server":{"name":"lector-startup-test","version":"1.0"},"capabilities":{"speak":true,"stop":true,"set_rate":true,"rpc_discover":true}}}\n' "$id"
            ;;
        *'"method":"speak"'*)
            if [[ $initialized -ne 1 ]]; then
                printf 'LECTOR-SPEECH-BEFORE-HANDSHAKE' >&2
                exit 65
            fi
            if [[ $request == *'LECTOR-TOP-LEVEL-SPEAK'* ]]; then
                printf '"LECTOR-TOP-LEVEL-SPEAK"\n' >> "$LECTOR_PROC_STUB_LOG"
            fi
            if [[ $request == *'LECTOR-STARTUP-HOOK-SPEAK'* ]]; then
                printf '"LECTOR-STARTUP-HOOK-SPEAK"\n' >> "$LECTOR_PROC_STUB_LOG"
            fi
            printf '{"jsonrpc":"2.0","id":%s,"result":null}\n' "$id"
            ;;
        *'"method":"stop"'*)
            printf '{"jsonrpc":"2.0","id":%s,"result":null}\n' "$id"
            ;;
        *'"method":"set_rate"'*)
            printf '{"jsonrpc":"2.0","id":%s,"result":{"rate":1.0}}\n' "$id"
            ;;
        *)
            printf '{"jsonrpc":"2.0","id":%s,"error":{"code":-32601,"message":"Method not found"}}\n' "$id"
            ;;
    esac
done
