#!/bin/bash

stty raw -echo
if infocmp -1 -x "$TERM" 2>/dev/null | grep -q '^[[:space:]]*Sync='; then
    lector_sync=sync
else
    lector_sync=missing-sync
fi
printf 'LECTOR-BELL-READY|ENV:%s:%s' "$TERM" "$lector_sync"
if [[ ${LECTOR_TEST_PRELOAD_OUTPUT:-} == 1 ]]; then
    lector_parent=$PPID
    (sleep 0.2; kill -CONT "$lector_parent") &
    kill -STOP "$lector_parent"
fi
while IFS= read -r -n 1 byte; do
    case "$byte" in
        $'\177') printf '\a' ;;
        q) exit 0 ;;
    esac
done
