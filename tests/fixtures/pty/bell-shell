#!/bin/bash

stty raw -echo
printf 'LECTOR-BELL-READY|ENV:%s:%s' "$TERM" "${TERMINFO-unset}"
if [[ ${LECTOR_TEST_PRELOAD_OUTPUT:-} == 1 ]]; then
    lector_parent=$PPID
    (sleep 0.2; kill -CONT "$lector_parent") &
    kill -STOP "$lector_parent"
fi
while IFS= read -r -n 1 byte; do
    case "$byte" in
        $'\177') printf '\a' ;;
        q) exit 0 ;;
    esac
done
