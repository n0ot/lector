#!/bin/bash

stty sane
"$LECTOR_TEST_BINARY" \
    --shell "$LECTOR_TEST_CHILD_SHELL" \
    --speech-driver proc \
    --speech-server "$LECTOR_TEST_SPEECH_SERVER"
lector_status=$?

# Model the interactive shell which regains this same terminal after Lector.
# Any reply left in the input queue is a lifecycle leak and would commonly be
# interpreted as an unknown key sequence, producing an audible bell.
stty raw -echo
if IFS= read -r -n 1 -t 0.25; then
    printf '\aLECTOR-PARENT-INPUT-LEAK'
fi
printf 'LECTOR-PARENT-AFTER:%s' "$lector_status"
exit "$lector_status"
