#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_dir"
host=$(rustc -vV | sed -n 's/^host: //p')
case "$host" in
    aarch64-apple-darwin|x86_64-apple-darwin)
        echo "macOS already uses its native Cargo target; no setup is needed."
        exit 0
        ;;
    aarch64-alpine-linux-musl|x86_64-alpine-linux-musl)
        target=$host
        ;;
    aarch64-unknown-linux-gnu|x86_64-unknown-linux-gnu|aarch64-unknown-linux-musl|x86_64-unknown-linux-musl)
        target=${host%%-*}-unknown-linux-musl
        rustup target add "$target"
        ;;
    *) echo "unsupported build host: $host" >&2; exit 2 ;;
esac

config="$repo_dir/.cargo/lector-local.toml"
marker='# Generated by scripts/setup; safe to regenerate.'
if [[ -e "$config" ]] && ! head -n 1 "$config" | grep -Fxq "$marker"; then
    echo "refusing to overwrite a manually maintained $config" >&2
    exit 1
fi
temporary=$(mktemp "$repo_dir/.cargo/.lector-setup.XXXXXX")
trap 'rm -f "$temporary"' EXIT
cat > "$temporary" <<EOF
$marker
[build]
target = "$target"

# Keep maintenance aliases and their nested Cargo builds on the same target.
[env]
CARGO_BUILD_TARGET = "$target"
EOF
mv "$temporary" "$config"
echo "Configured this checkout for $target. Use ordinary cargo build, test, and install commands."
