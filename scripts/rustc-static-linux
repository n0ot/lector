#!/usr/bin/env bash
set -euo pipefail

rustc_bin=$1
shift
# Native builds use Cargo's platform linker and the dynamic C runtime.
if [[ "${LECTOR_STATIC:-0}" != 1 ]]; then
    exec "$rustc_bin" "$@"
fi
arguments=("$@")
target=
for ((index = 0; index < ${#arguments[@]}; index++)); do
    case "${arguments[$index]}" in
        --target=*) target=${arguments[$index]#--target=} ;;
        --target) target=${arguments[$((index + 1))]} ;;
    esac
done
# Static cross builds use one linker/unwinder for binaries and test harnesses.
# Native Alpine keeps its packaged linker; cargo-musl supplies +crt-static.
if [[ "$target" == aarch64-unknown-linux-musl || "$target" == x86_64-unknown-linux-musl ]]; then
    export LECTOR_ZIG_CC_TARGET=${target/-unknown/}
    wrapper_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    exec "$rustc_bin" "${arguments[@]}" \
        -C target-feature=+crt-static \
        -C relocation-model=pic \
        -C linker="$wrapper_dir/zig-lld" \
        -C linker-flavor=ld.lld
fi
exec "$rustc_bin" "${arguments[@]}"
