#!/usr/bin/env bash
set -euo pipefail

rustc_bin=$1
shift
rustc_args=("$@")
crate_name=
target=
is_test=false

for ((index = 0; index < ${#rustc_args[@]}; index++)); do
    argument=${rustc_args[$index]}
    case "$argument" in
        --crate-name)
            if ((index + 1 < ${#rustc_args[@]})); then
                crate_name=${rustc_args[$((index + 1))]}
            fi
            ;;
        --crate-name=*) crate_name=${argument#--crate-name=} ;;
        --target)
            if ((index + 1 < ${#rustc_args[@]})); then
                target=${rustc_args[$((index + 1))]}
            fi
            ;;
        --target=*) target=${argument#--target=} ;;
        --test) is_test=true ;;
    esac
done

# Every cross-compiled musl workspace executable, including test harnesses,
# must use the same linker/unwinder as the release binary. A host GNU linker
# can otherwise mix its libgcc unwinder with Rust's bundled LLVM unwinder.
if [[ "$target" == *-linux-musl && -n "${LECTOR_ZIG_CC_TARGET:-}" ]]; then
    wrapper_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    exec "$rustc_bin" "${rustc_args[@]}" \
        -C target-feature=+crt-static \
        -C relocation-model=pic \
        -C linker="$wrapper_dir/zig-lld" \
        -C linker-flavor=ld.lld
fi

# Host proc-macro crates need shared objects. Add executable-specific PIE
# flags only to Lector's final musl invocation.
if [[ "$crate_name" == lector && "$is_test" == false ]]; then
    if [[ -z "$target" ]]; then
        target=$("$rustc_bin" -vV | sed -n 's/^host: //p')
    fi
    case "$target" in
        *-linux-musl)
            exec "$rustc_bin" "${rustc_args[@]}" \
                -C target-feature=+crt-static
            ;;
    esac
fi

exec "$rustc_bin" "${rustc_args[@]}"
