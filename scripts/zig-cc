#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
zig_target=${LECTOR_ZIG_CC_TARGET:-}

case "$zig_target" in
    aarch64-linux-musl|x86_64-linux-musl) ;;
    *)
        echo "LECTOR_ZIG_CC_TARGET must select a supported MUSL target" >&2
        exit 2
        ;;
esac

zig_bin=$("$repo_dir/scripts/bootstrap_zig.sh")
compiler_args=()
while (($# > 0)); do
    case "$1" in
        --target=*|-target=*) shift ;;
        --target|-target)
            shift
            if (($# > 0)); then
                shift
            fi
            ;;
        *)
            compiler_args+=("$1")
            shift
            ;;
    esac
done

exec "$zig_bin" cc -target "$zig_target" "${compiler_args[@]}"
