#!/usr/bin/env python3

"""Run the live tmux adversary suite in a killable process group."""

import argparse
import os
from pathlib import Path
import signal
import subprocess
import sys


def terminate_process_group(process) -> None:
    """Terminate and reap Cargo together with every test process it spawned."""
    if process.poll() is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        process.wait()
        return
    try:
        process.wait(timeout=2.0)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Build Lector and run the live adversarial tmux-control scenarios. "
            "The complete Cargo process group is killed if the suite hangs."
        )
    )
    parser.add_argument(
        "--timeout",
        type=float,
        default=60.0,
        help="whole-suite timeout in seconds (default: 60)",
    )
    args, cargo_args = parser.parse_known_args()
    if args.timeout <= 0:
        parser.error("--timeout must be positive")

    repository = Path(__file__).resolve().parent.parent
    command = [
        os.environ.get("CARGO", "cargo"),
        "test",
        "--locked",
        "--test",
        "tmux_adversary_live",
        "--",
        *cargo_args,
    ]
    print(f"running from {repository}: {' '.join(command)}", flush=True)
    process = subprocess.Popen(command, cwd=repository, start_new_session=True)
    received_signal = None

    def interrupt(signum, _frame) -> None:
        nonlocal received_signal
        received_signal = signum
        raise KeyboardInterrupt

    handled_signals = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
    previous_handlers = {
        signum: signal.signal(signum, interrupt) for signum in handled_signals
    }
    try:
        return process.wait(timeout=args.timeout)
    except subprocess.TimeoutExpired:
        print(
            f"tmux adversary suite exceeded {args.timeout:g}s; terminating process group",
            file=sys.stderr,
            flush=True,
        )
        terminate_process_group(process)
        return 124
    except KeyboardInterrupt:
        signum = received_signal or signal.SIGINT
        print(
            f"received signal {signum}; terminating Cargo process group",
            file=sys.stderr,
            flush=True,
        )
        terminate_process_group(process)
        return 128 + signum
    finally:
        if process.poll() is None:
            terminate_process_group(process)
        for signum, handler in previous_handlers.items():
            signal.signal(signum, handler)


if __name__ == "__main__":
    raise SystemExit(main())
