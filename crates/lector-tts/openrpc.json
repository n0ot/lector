{
  "openrpc": "1.4.0",
  "info": {
    "title": "Lector speech-host protocol",
    "description": "Version 2.1 of the bidirectional JSON-RPC interface between Lector and a speech host. Messages are UTF-8 NDJSON over stdio. See docs/speech-driver-protocol.md for normative transport, capability, state-machine, timeout, and recovery semantics.",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/license/mit"
    },
    "version": "2.1.0"
  },
  "externalDocs": {
    "description": "Normative RFC-style protocol specification",
    "url": "../../docs/speech-driver-protocol.md"
  },
  "methods": [
    {
      "name": "initialize",
      "summary": "Negotiate a protocol version and host capabilities",
      "description": "Sent once before speech methods. rpc.discover is the only method also available before initialization.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "protocol",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/ProtocolRange"
          }
        },
        {
          "name": "client",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/PeerInfo"
          }
        },
        {
          "name": "clientCapabilities",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/ClientCapabilities"
          }
        }
      ],
      "result": {
        "name": "initialization",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/InitializeResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/InvalidParams"
        },
        {
          "$ref": "#/components/errors/UnsupportedProtocol"
        }
      ]
    },
    {
      "name": "rpc.discover",
      "summary": "Return this host's OpenRPC document",
      "description": "Available before and after initialize. It takes no parameters.",
      "params": [],
      "result": {
        "name": "openrpcDocument",
        "required": true,
        "schema": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    {
      "name": "speech.speak",
      "summary": "Accept one active logical utterance",
      "description": "The host must reject this call while another logical utterance is active. Lector owns queueing.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "utteranceId",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/UtteranceId"
          }
        },
        {
          "name": "text",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "x-lector-maximumUtf8Bytes": 65536
          }
        }
      ],
      "result": {
        "name": "accepted",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/AcceptedResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/InvalidState"
        },
        {
          "$ref": "#/components/errors/InvalidParams"
        },
        {
          "$ref": "#/components/errors/BackendError"
        }
      ]
    },
    {
      "name": "speech.stop",
      "summary": "Cancel the identified active utterance",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "utteranceId",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/UtteranceId"
          }
        }
      ],
      "result": {
        "name": "accepted",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/AcceptedResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/InvalidState"
        },
        {
          "$ref": "#/components/errors/InvalidParams"
        },
        {
          "$ref": "#/components/errors/BackendError"
        }
      ]
    },
    {
      "name": "speech.pause",
      "summary": "Pause and capture a resumable position",
      "description": "Implemented only when controls.pauseResume advertises a supported mode.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "utteranceId",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/UtteranceId"
          }
        }
      ],
      "result": {
        "name": "pause",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/PauseResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/InvalidState"
        },
        {
          "$ref": "#/components/errors/InvalidParams"
        },
        {
          "$ref": "#/components/errors/MethodNotFound"
        },
        {
          "$ref": "#/components/errors/BackendError"
        }
      ]
    },
    {
      "name": "speech.resume",
      "summary": "Resume the identified paused utterance",
      "description": "For restartFromWord, resynthesis starts at the exact UTF-8 word position returned by speech.pause.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "utteranceId",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/UtteranceId"
          }
        }
      ],
      "result": {
        "name": "accepted",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/AcceptedResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/InvalidState"
        },
        {
          "$ref": "#/components/errors/InvalidParams"
        },
        {
          "$ref": "#/components/errors/MethodNotFound"
        },
        {
          "$ref": "#/components/errors/BackendError"
        }
      ]
    },
    {
      "name": "speech.getRate",
      "summary": "Return the current host speaking rate",
      "description": "Protocol 2.1 method implemented only when settings.rate is readWrite.",
      "params": [],
      "result": {
        "name": "currentRate",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/RateResult"
        }
      },
      "errors": [
        { "$ref": "#/components/errors/MethodNotFound" },
        { "$ref": "#/components/errors/BackendError" }
      ]
    },
    {
      "name": "speech.setRate",
      "summary": "Set the host speaking rate",
      "description": "The host may clamp the request and returns its finite effective value.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "rate",
          "required": true,
          "schema": {
            "type": "number",
            "description": "A finite value in the host backend's rate domain."
          }
        }
      ],
      "result": {
        "name": "effectiveRate",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/RateResult"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/InvalidParams"
        },
        {
          "$ref": "#/components/errors/MethodNotFound"
        },
        {
          "$ref": "#/components/errors/BackendError"
        }
      ]
    },
    {
      "name": "speech.getPitch",
      "summary": "Return the current host speaking pitch",
      "description": "Implemented only when settings.pitch is readWrite.",
      "params": [],
      "result": {
        "name": "currentPitch",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/PitchResult"
        }
      },
      "errors": [
        { "$ref": "#/components/errors/MethodNotFound" },
        { "$ref": "#/components/errors/BackendError" }
      ]
    },
    {
      "name": "speech.setPitch",
      "summary": "Set the host speaking pitch",
      "description": "The host may clamp the request and returns its finite effective value.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "pitch",
          "required": true,
          "schema": {
            "type": "number",
            "description": "A finite value in the host backend's pitch domain."
          }
        }
      ],
      "result": {
        "name": "effectivePitch",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/PitchResult"
        }
      },
      "errors": [
        { "$ref": "#/components/errors/InvalidParams" },
        { "$ref": "#/components/errors/MethodNotFound" },
        { "$ref": "#/components/errors/BackendError" }
      ]
    },
    {
      "name": "speech.getVolume",
      "summary": "Return the current host speaking volume",
      "description": "Implemented only when settings.volume is readWrite.",
      "params": [],
      "result": {
        "name": "currentVolume",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/VolumeResult"
        }
      },
      "errors": [
        { "$ref": "#/components/errors/MethodNotFound" },
        { "$ref": "#/components/errors/BackendError" }
      ]
    },
    {
      "name": "speech.setVolume",
      "summary": "Set the host speaking volume",
      "description": "The host may clamp the request and returns its finite effective value.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "volume",
          "required": true,
          "schema": {
            "type": "number",
            "description": "A finite value in the host backend's volume domain."
          }
        }
      ],
      "result": {
        "name": "effectiveVolume",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/VolumeResult"
        }
      },
      "errors": [
        { "$ref": "#/components/errors/InvalidParams" },
        { "$ref": "#/components/errors/MethodNotFound" },
        { "$ref": "#/components/errors/BackendError" }
      ]
    },
    {
      "name": "speech.listVoices",
      "summary": "List voices exposed by the selected backend",
      "description": "Implemented only when voices.list is true.",
      "params": [],
      "result": {
        "name": "voiceList",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/VoiceListResult"
        }
      },
      "errors": [
        { "$ref": "#/components/errors/MethodNotFound" },
        { "$ref": "#/components/errors/BackendError" }
      ]
    },
    {
      "name": "speech.getVoice",
      "summary": "Return the selected backend voice",
      "description": "Implemented only when voices.current is true. A null voice represents the backend default when the backend can report that state without identifying a concrete voice.",
      "params": [],
      "result": {
        "name": "currentVoice",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/CurrentVoiceResult"
        }
      },
      "errors": [
        { "$ref": "#/components/errors/MethodNotFound" },
        { "$ref": "#/components/errors/BackendError" }
      ]
    },
    {
      "name": "speech.setVoice",
      "summary": "Select a backend voice by ID",
      "description": "Implemented only when voices.select is true and returns the effective current voice.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "voiceId",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "result": {
        "name": "currentVoice",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/CurrentVoiceResult"
        }
      },
      "errors": [
        { "$ref": "#/components/errors/InvalidParams" },
        { "$ref": "#/components/errors/MethodNotFound" },
        { "$ref": "#/components/errors/BackendError" }
      ]
    }
  ],
  "components": {
    "errors": {
      "InvalidState": {
        "code": -32600,
        "message": "Invalid request or state transition"
      },
      "MethodNotFound": {
        "code": -32601,
        "message": "Method or capability not supported"
      },
      "InvalidParams": {
        "code": -32602,
        "message": "Invalid params"
      },
      "BackendError": {
        "code": -32603,
        "message": "Speech backend error"
      },
      "UnsupportedProtocol": {
        "code": -32001,
        "message": "No compatible Lector speech protocol version"
      }
    },
    "schemas": {
      "ProtocolRange": {
        "type": "object",
        "required": [
          "major",
          "minimumMinor",
          "maximumMinor"
        ],
        "properties": {
          "major": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "minimumMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "maximumMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "additionalProperties": true
      },
      "ProtocolVersion": {
        "type": "object",
        "required": [
          "major",
          "minor"
        ],
        "properties": {
          "major": {
            "const": 2
          },
          "minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "additionalProperties": true
      },
      "PeerInfo": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "ClientCapabilities": {
        "type": "object",
        "required": [
          "speechEvents",
          "progressModes"
        ],
        "properties": {
          "speechEvents": {
            "const": true
          },
          "progressModes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      },
      "InitializeResult": {
        "type": "object",
        "required": [
          "protocol",
          "server",
          "capabilities"
        ],
        "properties": {
          "protocol": {
            "$ref": "#/components/schemas/ProtocolVersion"
          },
          "server": {
            "$ref": "#/components/schemas/PeerInfo"
          },
          "backend": {
            "$ref": "#/components/schemas/BackendInfo"
          },
          "capabilities": {
            "$ref": "#/components/schemas/SpeechCapabilities"
          }
        },
        "additionalProperties": true
      },
      "SpeechCapabilities": {
        "type": "object",
        "properties": {
          "lifecycle": {
            "$ref": "#/components/schemas/LifecycleCapabilities"
          },
          "progress": {
            "$ref": "#/components/schemas/ProgressCapabilities"
          },
          "controls": {
            "$ref": "#/components/schemas/ControlCapabilities"
          },
          "settings": {
            "$ref": "#/components/schemas/SettingCapabilities"
          },
          "voices": {
            "$ref": "#/components/schemas/VoiceCapabilities"
          }
        },
        "additionalProperties": true,
        "description": "Missing and unknown capabilities are unsupported."
      },
      "DeliveryGuarantee": {
        "type": "string",
        "examples": [
          "reliable",
          "bestEffort",
          "unsupported"
        ],
        "x-lector-knownValues": [
          "reliable",
          "bestEffort",
          "unsupported"
        ],
        "description": "Unknown values are treated as unsupported."
      },
      "EventCapability": {
        "type": "object",
        "properties": {
          "delivery": {
            "$ref": "#/components/schemas/DeliveryGuarantee"
          }
        },
        "additionalProperties": true
      },
      "TerminalCapability": {
        "type": "object",
        "properties": {
          "delivery": {
            "$ref": "#/components/schemas/DeliveryGuarantee"
          },
          "distinguishes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      },
      "LifecycleCapabilities": {
        "type": "object",
        "properties": {
          "started": {
            "$ref": "#/components/schemas/EventCapability"
          },
          "terminal": {
            "$ref": "#/components/schemas/TerminalCapability"
          }
        },
        "additionalProperties": true
      },
      "ProgressMode": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "examples": [
              "utf8ByteOffset",
              "marker"
            ]
          },
          "granularity": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      },
      "ProgressCapabilities": {
        "type": "object",
        "properties": {
          "modes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProgressMode"
            }
          }
        },
        "additionalProperties": true
      },
      "StopSupport": {
        "type": "string",
        "examples": [
          "confirmed",
          "bestEffort",
          "unsupported"
        ],
        "x-lector-knownValues": [
          "confirmed",
          "bestEffort",
          "unsupported"
        ],
        "description": "Unknown values are treated as unsupported."
      },
      "PauseResumeSupport": {
        "type": "string",
        "examples": [
          "restartFromWord",
          "unsupported"
        ],
        "x-lector-knownValues": [
          "restartFromWord",
          "unsupported"
        ],
        "description": "restartFromWord also requires word-granularity utf8ByteOffset progress."
      },
      "ControlCapabilities": {
        "type": "object",
        "properties": {
          "stop": {
            "$ref": "#/components/schemas/StopSupport"
          },
          "pauseResume": {
            "$ref": "#/components/schemas/PauseResumeSupport"
          }
        },
        "additionalProperties": true
      },
      "SettingSupport": {
        "type": "string",
        "examples": [
          "readWrite",
          "writeOnly",
          "unsupported"
        ],
        "x-lector-knownValues": [
          "readWrite",
          "writeOnly",
          "unsupported"
        ],
        "description": "Unknown values are treated as unsupported."
      },
      "SettingCapabilities": {
        "type": "object",
        "properties": {
          "rate": {
            "$ref": "#/components/schemas/SettingSupport"
          },
          "pitch": {
            "$ref": "#/components/schemas/SettingSupport"
          },
          "volume": {
            "$ref": "#/components/schemas/SettingSupport"
          }
        },
        "additionalProperties": true
      },
      "BackendInfo": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      },
      "VoiceCapabilities": {
        "type": "object",
        "properties": {
          "list": { "type": "boolean" },
          "current": { "type": "boolean" },
          "select": { "type": "boolean" }
        },
        "additionalProperties": true,
        "description": "Missing voice-operation flags are false. Backends whose voice is managed externally advertise none of them."
      },
      "VoiceInfo": {
        "type": "object",
        "required": ["id", "name", "language"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 },
          "gender": {
            "type": "string",
            "examples": ["male", "female"]
          }
        },
        "additionalProperties": true
      },
      "VoiceListResult": {
        "type": "object",
        "required": ["voices"],
        "properties": {
          "voices": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/VoiceInfo" }
          }
        },
        "additionalProperties": true
      },
      "CurrentVoiceResult": {
        "type": "object",
        "required": ["voice"],
        "properties": {
          "voice": {
            "oneOf": [
              { "$ref": "#/components/schemas/VoiceInfo" },
              { "type": "null" }
            ]
          }
        },
        "additionalProperties": true
      },
      "UtteranceId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "x-lector-maximumUtf8Bytes": 128,
        "description": "Opaque Lector-assigned identifier. It is always a JSON string."
      },
      "AcceptedResult": {
        "type": "object",
        "required": [
          "accepted"
        ],
        "properties": {
          "accepted": {
            "const": true
          }
        },
        "additionalProperties": true
      },
      "TextPosition": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "examples": [
              "utf8ByteOffset",
              "marker"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "A character boundary in the UTF-8 bytes of the original speech.speak text."
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true,
        "description": "utf8ByteOffset requires offset; marker requires id. Unknown kinds must be ignored."
      },
      "PauseResult": {
        "type": "object",
        "required": [
          "paused"
        ],
        "properties": {
          "paused": {
            "type": "boolean"
          },
          "position": {
            "$ref": "#/components/schemas/TextPosition"
          }
        },
        "additionalProperties": true,
        "description": "paused=true requires a valid position; paused=false omits position."
      },
      "RateResult": {
        "type": "object",
        "required": [
          "rate"
        ],
        "properties": {
          "rate": {
            "type": "number",
            "description": "The finite effective backend rate."
          }
        },
        "additionalProperties": true
      },
      "PitchResult": {
        "type": "object",
        "required": [
          "pitch"
        ],
        "properties": {
          "pitch": {
            "type": "number",
            "description": "The finite effective backend pitch."
          }
        },
        "additionalProperties": true
      },
      "VolumeResult": {
        "type": "object",
        "required": [
          "volume"
        ],
        "properties": {
          "volume": {
            "type": "number",
            "description": "The finite effective backend volume."
          }
        },
        "additionalProperties": true
      },
      "SpeechEvent": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "examples": [
              "started",
              "progress",
              "paused",
              "resumed",
              "ended"
            ]
          },
          "position": {
            "$ref": "#/components/schemas/TextPosition"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "examples": [
              "completed",
              "cancelled",
              "failed"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true,
        "description": "progress and paused require position; ended requires reason. Unknown event types are ignored."
      },
      "SpeechEventNotificationParams": {
        "type": "object",
        "required": [
          "utteranceId",
          "sequence",
          "event"
        ],
        "properties": {
          "utteranceId": {
            "$ref": "#/components/schemas/UtteranceId"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "event": {
            "$ref": "#/components/schemas/SpeechEvent"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "x-lector-notifications": [
    {
      "name": "speech.event",
      "direction": "server-to-client",
      "description": "Correlated lifecycle or progress evidence. The JSON-RPC object has no id and receives no response.",
      "params": {
        "$ref": "#/components/schemas/SpeechEventNotificationParams"
      }
    }
  ],
  "x-lector-transport": {
    "kind": "stdio",
    "encoding": "utf-8",
    "framing": "ndjson-lf",
    "maximumFrameBytes": 1048576,
    "maximumInFlightRequests": 1,
    "serverNotifications": true,
    "serverRequests": false,
    "batchRequests": false,
    "initializeDeadlineMilliseconds": 5000,
    "requestDeadlineMilliseconds": 1000
  },
  "x-lector-protocol": {
    "major": 2,
    "minor": 1,
    "unknownMembers": "ignore",
    "unknownCapabilities": "unsupported",
    "unknownNotifications": "ignore",
    "positionEncoding": "utf-8",
